PORT=3000
# Cadena de conexión de MongoDB Atlas. Nunca publiques este valor.
MONGO_URI=
# Orígenes permitidos por CORS, separados por coma y sin barra final.
FRONTEND_URL=http://localhost:5173,http://localhost:5174,https://sharickotero-ui.github.io
# Credenciales del administrador. Guarda el hash bcrypt, no la contraseña en texto plano.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Secreto largo y aleatorio para firmar los JWT.
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest