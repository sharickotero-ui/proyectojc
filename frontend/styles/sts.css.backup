:root{ 
    --primary-color: #f1e4ca; 
    --secondary-color: #9a7456;
    --tertiary-color: #BB9457;
    --quaternary-color: #321e12;
    --quinary-color: #99582A;
    --font-family: 'Noto Sans SC', sans-serif;
    --bg-color: var(--primary-color);
    --letter-spacing: 0.5px;
    
}

* {
  margin: 0; 
  padding: 0; 
  box-sizing: border-box; 
}


html {
    font-size:62.5%;
    scroll-behavior:smooth;
}

body{
  background-color: var(--bg-color);
  font-family: var(--font-family);
  font-size: 2rem;
  font-weight: bolder;
  line-height: 1.5;
  letter-spacing: var(--letter-spacing);
  color: var(--quaternary-color);
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  font-family: var(--font-family);
  cursor: pointer;
}

header{ 
  background-color: var(--secondary-color);
  width: 100%; 
  display:grid;
  grid-template-columns: 1fr ;
  align-items:center;
  gap: 0; 
  padding:0.5rem clamp(1rem, 4vw, 3rem) 1.5rem;
  box-sizing: border-box; 
  position: sticky;
  top: 0;
  width: 100%;
  z-index: 1000;
}

.logo{
    display: flex;
    align-items: center;
    justify-content: center;
}
.logo img {
    width: clamp(120px, 20vw, 300px);
    height: auto;
    display: block;
    margin-block: -5rem;
}

nav {
    justify-content: center;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
}

nav a {
  color: var(--quaternary-color);
  font-size: 3rem;
  text-decoration: none;
  transition: .3s;
}
nav a:hover, 
nav a:focus-visible{
  color: var(--tertiary-color);
}

nav .boton-contacto {
  display: inline-block;
  background: var(--tertiary-color);
  color: var(--quaternary-color);
  font-family: var(--font-family);
  font-weight: bolder;
  padding: 0.75rem 1.5rem;
  border-radius: 6rem;
  font-size: 2rem;
  transition: .3s;
}
nav .boton-contacto:hover,
nav .boton-contacto:focus-visible{
  background: var(--primary-color);
}

#inicio {
  min-height:auto;
  padding: 0rem 0 0 5%;
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  align-items: center;
  gap: 5rem;
  position: relative;
  overflow: hidden;
}

.inicio-texto {
  position: relative;
  z-index: 2;

}
.inicio-texto a {
  display: inline-block;
  margin-top: 1rem;
  font-size: 2rem;
  font-weight: bold;
  border-radius: 999px;
  text-decoration: none;
  transition: transform 0.2s;
}

.inicio-texto a:hover {
  transform: translateY(-3px);
  color: var(--secondary-color);

}

#inicio h1 {
  color: var(--quaternary-color);
  font-size: 7rem;
  line-height: 1.1;
  margin-bottom: 2.5rem;
  font-weight: bolder;
}
#inicio strong{
  color: var(--quinary-color);
  font-size: 15rem;
}

#titulo-inicio {
  color: var(--quinary-color);
  font-size: 3rem;
  text-transform: uppercase;
  margin-bottom: 1.5rem;
  font-weight: bolder;
}

#inicio p {
  color: var(--quinary-color);
  font-size: 3rem;
  opacity: 0.8;
}

.foto {
  height: min(100rem, 100vh);
  position: relative;
  overflow: hidden;
}

.foto img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;

  -webkit-mask-image: linear-gradient(to right, transparent 0%, black 2%);
  mask-image: linear-gradient(to right, transparent 0%, black 25%);
}

#menu {
  padding: 5rem clamp(2rem, 6vw, 8rem);
}

#menu > div:first-child {
  max-width: 75rem;
  margin: 0 auto 3rem;
  text-align: center;
}

#titulo-menu {
  margin-bottom: 1rem;
  font-size: 4rem;
}

#menu > div:first-child p {
  font-size: 2rem;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
  gap: 2.5rem;
  max-width: 120rem;
  margin: 0 auto;
}

.menu-grid article {
  overflow: hidden;
  background-color: #fffaf0;
  border-radius: 1.5rem;
  box-shadow: 0 0.6rem 1.8rem rgb(50 30 18 / 12%);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.menu-grid article:hover {
  transform: translateY(-0.4rem);
  box-shadow: 0 1rem 2.4rem rgb(50 30 18 / 18%);
}

.menu-grid article img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}

.menu-grid article h3,
.menu-grid article p {
  margin-inline: 2rem;
}

.menu-grid article h3 {
  margin-top: 1.5rem;
  font-size: 2.5rem;
}

.menu-grid article p {
  margin-top: 0.5rem;
  margin-bottom: 2rem;
  font-size: 1.7rem;
  font-weight: normal;
}

@media (max-width: 768px) {
  .logo img {
    width: clamp(120px, 35vw, 220px);
    margin-block: -2rem;
  }

  nav {
    gap: 1.2rem;
  }

  nav a {
    font-size: 2rem;
  }

  nav .boton-contacto {
    font-size: 1.8rem;
  }

  #inicio {
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 3rem 2rem 0;
  }

  #inicio h1 {
    font-size: 4.5rem;
  }

  #inicio strong {
    font-size: 7rem;
  }

  #titulo-inicio,
  #inicio p {
    font-size: 2.2rem;
  }

  .foto {
    height: min(45rem, 60vh);
  }

  .foto img {
    -webkit-mask-image: none;
    mask-image: none;
  }

  #menu {
    padding-block: 4rem;
  }
}

@media (max-width: 480px) {
  nav {
    gap: 0.8rem;
  }

  nav a {
    font-size: 1.7rem;
  }

  nav .boton-contacto {
    font-size: 1.6rem;
    padding: 0.6rem 1rem;
  }

  #inicio {
    padding-inline: 1.5rem;
  }

  #inicio h1 {
    font-size: 3.6rem;
  }

  #inicio strong {
    font-size: 5.5rem;
  }
}
